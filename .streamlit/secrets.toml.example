# Copy to .streamlit/secrets.toml for local use (never commit the real file),
# or paste these keys into Streamlit Cloud → App → Settings → Secrets.
MONGO_URI = "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0"
GEMINI_API_KEY = "your-gemini-api-key"

# Optional – only needed to run the data pipelines
FRED_API_KEY = ""
DATA_GOV_KEY = ""
GNEWS_API_KEY = ""
